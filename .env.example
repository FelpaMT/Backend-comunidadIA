DJANGO_SECRET_KEY=replace-with-a-generated-random-secret-key-of-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
MAX_UPLOAD_SIZE=5242880
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

USE_POSTGRES=True
DB_NAME=replace-with-cpanel-prefixed-database-name
DB_USER=replace-with-cpanel-prefixed-database-user
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Set to require when your PostgreSQL provider requires TLS.
# DB_SSLMODE=require

# Tiempo en minutos
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

PUBLIC_ROOT=/home/CPANEL_USER/public_html
STATIC_ROOT=/home/CPANEL_USER/public_html/static
MEDIA_ROOT=/home/CPANEL_USER/public_html/comunidadia_uploads
DOMAIN=https://www.your-domain.example
FRONTEND_URL=https://www.your-domain.example

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.8-flash

# cPanel email account (use values supplied by your hosting provider).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.your-domain.example
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=no-reply@your-domain.example
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
DEFAULT_FROM_EMAIL=ComunidadIA <no-reply@your-domain.example>
